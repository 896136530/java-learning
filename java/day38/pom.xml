<?xml version="1.0" encoding="UTF-8"?>
<!--
  Day38：MyBatis 基础
  MyBatis 只需要一个 Java 文件（App）+ 两个 XML 配置，不用 Spring、不用 Tomcat。
  今天要理解的就是这三层：
    mybatis-config.xml   全局配置（连哪个库、日志、mapper 在哪）
    mapper/xxx.xml       一条 SQL 一个 <select>/<insert>
    XxxMapper.java       接口方法名 = XML 里 <select> 的 id
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.xiaoming</groupId>
  <artifactId>day38-mybatis</artifactId>
  <version>1.0</version>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <!-- 今天的主角：MyBatis 3.5.16（一个 jar，没有 Spring 依赖） -->
    <dependency>
      <groupId>org.mybatis</groupId>
      <artifactId>mybatis</artifactId>
      <version>3.5.16</version>
    </dependency>

    <!-- MySQL 驱动（同 Day21~37） -->
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <version>8.4.0</version>
    </dependency>

    <!-- 日志门面：MyBatis 用 slf4j，没有实现会打一行警告；simple 把它打到控制台 -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>2.0.13</version>
    </dependency>
  </dependencies>

  <build>
    <finalName>day38-mybatis</finalName>
    <plugins>
      <!-- 打成胖 jar：java -jar target\day38-mybatis.jar 就能跑（Day29 学过 shade） -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.1</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>com.xiaoming.day38.App</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>