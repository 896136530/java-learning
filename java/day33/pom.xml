<?xml version="1.0" encoding="UTF-8"?>
<!--
  Day 33：拦截器 / 过滤器

  ⭐ 这个 pom 和 Day32 的**一模一样**（只改了名字）—— 今天同样一个新依赖都不加。
     因为今天要用的东西全都在 spring-boot-starter-web 里：
       jakarta.servlet.Filter / FilterChain / FilterRegistrationBean
       org.springframework.web.servlet.HandlerInterceptor / WebMvcConfigurer

  📌 顺便体会一件事：Filter 属于 **Servlet 规范**，Spring 只是帮你把它注册进来；
     Interceptor 属于 **Spring MVC**，是 Spring 自己的一套。两者出身不同（见知识点第 6 节）。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- parent：继承 SpringBoot 的默认配置 + 版本管理（老三样，Day30 起没变过） -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.5</version>
    <relativePath/>
  </parent>

  <groupId>com.xiaoming</groupId>
  <artifactId>day33-springboot</artifactId>
  <version>1.0</version>
  <name>day33-springboot</name>
  <description>Day33：拦截器 / 过滤器（Filter / HandlerInterceptor / ThreadLocal）</description>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.parameters>true</maven.compiler.parameters>
  </properties>

  <dependencies>
    <!-- web：SpringMVC + 内嵌 Tomcat + Jackson（Filter / Interceptor 都从这里来） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- 数据访问：JPA + H2（和 Day31/32 一样，今天**不用数据库**，专心搞拦截器） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- 参数校验（Day32 的主角；今天留着它，是为了"拦截器 + 校验"能一起跑） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>