<?xml version="1.0" encoding="UTF-8"?>
<!--
  Day 34：Spring 事务管理 @Transactional（声明式事务）

  ⭐ 和 Day33 的 pom 有两处**故意**的差别（都是今天这个主题逼出来的）：

    ① 把 spring-boot-starter-data-jpa 换成 **spring-boot-starter-jdbc**
       为什么？（知识点第 12 节有完整选型理由，这里先给一句话）
       今天要观察的是"**数据到底有没有写进库**"，而 JPA 有"持久化上下文 + 一级缓存"，
       `save()` 之后不 flush 是不会发 SQL 的 —— 于是"没写进库"有可能是缓存没刷，
       也有可能是事务回滚，**两种原因混在一起就说不清了**。
       换成 JdbcTemplate：每一行代码对应一条真实 SQL，**数据库里有多少行就是多少行**。
       📌 而且 Day30 你已经用过 JPA 了，今天换个视角，Day38~40 的 MyBatis 也是 SQL 视角。

    ② 打开 H2（今天必须真有一个数据库）
       Day31/32/33 那三天用 `spring.autoconfigure.exclude` 把数据库**关掉**，
       是为了"隔离无关变量、专心学新概念"。
       今天不行 —— **事务是数据库的行为**，没有库就没有事务可谈。
       用 H2 内存库（`jdbc:h2:mem:day34`）：不用装、不用配、进程一停数据就没了
       （"数据复位"和"事务回滚"是两件事，知识点第 13 节专门讲这个区别）。
       Day35 再把它换成真的 MySQL。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- parent：继承 SpringBoot 的默认配置 + 版本管理（老三样，Day30 起没变过） -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.5</version>
    <relativePath/>
  </parent>

  <groupId>com.xiaoming</groupId>
  <artifactId>day34-springboot</artifactId>
  <version>1.0</version>
  <name>day34-springboot</name>
  <description>Day34：Spring 事务管理 @Transactional（声明式事务 / 事务失效 / 传播行为）</description>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.parameters>true</maven.compiler.parameters>
  </properties>

  <dependencies>
    <!-- web：SpringMVC + 内嵌 Tomcat + Jackson（Day31~33 的成果全在这里） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- ⭐ 今天的主角之一：spring-jdbc（JdbcTemplate）+ HikariCP 连接池 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>

    <!-- ⭐ H2 内存数据库：进程一停数据就没了（Day35 换成 mysql-connector-j） -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- 参数校验（Day32 的主角；今天留着它，是为了"老功能不能退化"） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>