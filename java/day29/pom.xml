<?xml version="1.0" encoding="UTF-8"?>
<!--
  Day 29 的 Maven 项目描述文件（pom.xml）—— 这是"项目身份证 + 购物清单"。

  今天你要练的三件事，全都在这个文件里：
    ① 项目坐标（GAV）：groupId / artifactId / version —— 全球唯一标识这个项目
    ② 依赖（dependencies）：写在这里，Maven 自己去下载，**不用再手动下 jar 扔 lib/**
    ③ 打包插件（build/plugins）：让 mvn package 产出一个能 java -jar 直接跑的文件
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

  <!-- 这两行是 Maven 4.0 的固定格式，一个字都别改 -->
  <modelVersion>4.0.0</modelVersion>

  <!-- ① 项目坐标 GAV —— 相当于项目的"姓名 + 身份证号" -->
  <groupId>com.xiaoming</groupId>          <!-- 组织/公司/个人域名倒写 -->
  <artifactId>day29-maven</artifactId>     <!-- 项目名 -->
  <version>1.0</version>                   <!-- 版本号 -->

  <properties>
    <maven.compiler.source>21</maven.compiler.source>
    <maven.compiler.target>21</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <!-- ② 依赖：以前手动下载 mysql-connector-j.jar 扔进 lib/，现在只要这三行 -->
  <dependencies>
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <version>8.4.0</version>
      <!-- 💡 这三个标签的顺序就是 GAV；写错一个字，Maven 会去仓库里翻半天然后报"找不到" -->
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- ③-a 直接运行某个类：mvn exec:java -Dexec.mainClass=ex1.HelloMaven -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.1.0</version>
      </plugin>

      <!-- ③-b 打"胖 jar"：把依赖一起塞进 jar，这样 java -jar xxx.jar 免 -cp 直接跑 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.1</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>ex1.HelloMaven</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>