<?xml version="1.0" encoding="UTF-8"?>
<!--
  Day 30：SpringBoot 上手 —— 这是你第一个 SpringBoot 项目的 pom.xml

  ⭐ 对比 Day29 的 pom.xml，你会发现最重要的变化：
     Day29：你**手动**声明每个依赖（mysql 驱动），手动配 exec/shade 插件
     Day30：你声明一个 **parent**（spring-boot-starter-parent），
            然后依赖只写"我要用什么能力"（starter），版本号**全都不用写**！
            → 这就是"约定优于配置"：SpringBoot 帮你把版本对齐好了
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- ① parent：继承 SpringBoot 的"默认配置 + 版本管理"（Day29 没有这个） -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.5</version>
    <relativePath/>
  </parent>

  <!-- ② GAV：和 Day29 一模一样的三行（说明"Maven 项目"这个身份没变） -->
  <groupId>com.xiaoming</groupId>
  <artifactId>day30-springboot</artifactId>
  <version>1.0</version>
  <name>day30-springboot</name>
  <description>Day30：SpringBoot 上手（第一个 Web 项目）</description>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- ⭐ 让 javac 把参数名保留到字节码里：Spring 靠它绑定 @RequestParam 的名字 -->
    <maven.compiler.parameters>true</maven.compiler.parameters>
  </properties>

  <dependencies>
    <!-- ③-a starter：一个依赖 = 一整套能力。
         spring-boot-starter-web 里面装着：SpringMVC + 内嵌 Tomcat + Jackson(JSON) ...
         注意：**没有版本号** —— parent 已经管好了 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- ③-b 数据访问：JPA（自动帮你写 SQL）+ H2（一个不用安装、纯 Java 的数据库） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- ③-c 测试（Day31 会用；先放着，不影响运行） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- ============================================================
         TODO⑥（附加题）：pom 里加依赖 → 代码里用起来

         ⭐ 先"读"下面这三行 —— 这就是"往 pom 加依赖"的全部内容：

              <groupId>org.apache.commons</groupId>     ← 谁做的
              <artifactId>commons-lang3</artifactId>    ← 叫什么
              <version>3.14.0</version>                 ← 哪个版本

         📌 三行怎么读 = Maven 拿它去拼 jar 的路径：
              .m2\repository\org\apache\commons\commons-lang3\3.14.0\commons-lang3-3.14.0.jar
              └── groupId 点变斜杠 ──┘ └ artifactId ┘ └version┘

         ⚠️ 第三方包**必须自己写 version**。SpringBoot 自家的包不用写，
            是因为 parent 里登记过；第三方包少写 version → 构建直接失败：
              'dependencies.dependency.version' for org.apache.commons:commons-lang3:jar is missing

         你要做的只有两件（pom 不用改了，已经写好）：
           ① TaskController 里 import StringUtils（包名自己拼：org.apache.commons.lang3.???）
           ② 把 8 个任务标题拼成一个长串，用 StringUtils.length(...) 数总字数，
              放进 /tasks/report 的 "totalChars" 字段

         验证：
           运行SpringBoot.bat 选 5   → 依赖树里能看到 commons-lang3:3.14.0
           mvn package && java -jar  → 47 MB 的 jar 里多了它
           /tasks/report             → 多出 "totalChars": 那个数字
         ============================================================ -->
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-lang3</artifactId>
      <version>3.14.0</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- ④ ⭐ 这个插件 = Day29 那个 shade 插件的"官方升级版"
           它同样把依赖打进 jar，但还会自动写好 Main-Class、把类挪到 BOOT-INF/ 里
           （SpringBoot 专用的可执行 jar 布局） -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>